{
  "name": "@api-starter-kit/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    "./data": "./.adonisjs/client/data.d.ts",
    "./registry": "./.adonisjs/client/registry/index.ts"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "codegen": "node ace codegen",
    "test": "node ace test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#transformers/*": "./app/transformers/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.6.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.4.0",
    "@poppinss/ts-exec": "^1.5.2",
    "@types/luxon": "^3.7.6",
    "@types/node": "~26.6.11",
    "eslint": "^10.15.0",
    "hot-hook": "^1.1.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.1",
    "@adonisjs/bodyparser": "^11.1.0",
    "@adonisjs/core": "^7.7.0",
    "@adonisjs/cors": "^3.0.1",
    "@adonisjs/http-server": "^9.4.0",
    "@adonisjs/lucid": "^22.5.0",
    "@adonisjs/session": "^8.4.0",
    "@adonisjs/shield": "^9.0.1",
    "@japa/api-client": "^3.2.1",
    "@tuyau/core": "^1.3.1",
    "@vinejs/vine": "^4.4.0",
    "better-sqlite3": "^13.2.0",
    "luxon": "^3.7.2",
    "reflect-metadata": "^0.2.2"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "allowScripts": {
    "@swc/core": true,
    "better-sqlite3": true,
    "esbuild": true,
    "fsevents": true
  },
  "prettier": "@adonisjs/prettier-config"
}
