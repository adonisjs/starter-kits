@layouts.app({ title: 'Dashboard' })
  @page()
    <div class="empty">
      <div class="empty__mark">
        @svg('lucide:layout-grid', { width: 22, height: 22 })
      </div>
      <h1>Your dashboard is ready</h1>
      <p>
        It's empty on purpose. A clean starting point with nothing to undo. Add your first route and component to begin.
      </p>
      <p class="mono" style="font-size: 12.5px; color: var(--subtle); margin-top: 4px;">
        Start in
        <span class="kbd">resources/views/pages/dashboard.edge</span>
      </p>
    </div>
  @end
@end
