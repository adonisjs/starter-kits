<!DOCTYPE html>
<html
  lang="en-us"
  data-theme="{{
    request.plainCookie('kit_theme', {
      defaultValue: 'light',
      encoded: false,
    })
  }}"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AdonisJS — Starter Kit</title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body>
    <div class="auth">
      <div class="auth__form-col">
        @!logo({ size: 28 })
        <div class="auth__form-wrap">{{{ await $slots.main() }}}</div>
        <div style="height: 20px;"></div>
      </div>

      <aside class="auth__aside">
        <div class="auth__aside-top">
          @!themeToggle()
        </div>

        <p class="auth__quote">Auth, kept intentionally minimal so you can build it your way.</p>

        <div>
          <div class="pitch__t">Looking for production-ready auth?</div>
          <p class="pitch__p">
            Check out Feature packs, production-ready full-stack components from the creator of AdonisJS.
          </p>
          <a
            class="il pitch__a"
            href="https://plus.adonisjs.com/feature-packs"
            target="_blank"
            rel="noreferrer"
          >
            Explore Feature packs →
          </a>
        </div>
      </aside>
    </div>
    @include('partials/flash_alerts')
  </body>
</html>
