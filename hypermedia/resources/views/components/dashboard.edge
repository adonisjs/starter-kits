<!DOCTYPE html>
<html
  lang="en-us"
  data-theme="{{
    request.plainCookie('kit_theme', {
      defaultValue: 'light',
      encoded: false,
    })
  }}"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AdonisJS — Starter Kit</title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body>
    <header class="dashbar">
      @!logo({ size: 28 })
      <div class="dashbar__right">
        @!themeToggle()
        @form({ route: 'session.destroy', method: 'POST' })
          <button type="submit" class="btn btn--secondary btn--sm">
            @svg('lucide:log-out', { width: 15, height: 15 })
            
            Log out

          </button>
        @end
      </div>
    </header>

    <nav class="subnav">
      <div class="subnav__inner">
        @link({
          route: 'dashboard',
          class: 'subnav__item subnav__item--active',
          'aria-current': 'page',
        })
          @svg('lucide:house', { width: 14, height: 14 })
          Dashboard
        @end
      </div>
    </nav>

    <div class="dash">{{{ await $slots.main() }}}</div>
    @include('partials/flash_alerts')
  </body>
</html>
