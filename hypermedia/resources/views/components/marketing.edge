<!DOCTYPE html>
<html
  lang="en-us"
  data-theme="{{
    request.plainCookie('kit_theme', {
      defaultValue: 'light',
      encoded: false,
    })
  }}"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AdonisJS — Starter Kit</title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body>
    <header class="appbar">
      <div class="appbar__inner">
        @!logo({ size: 28 })
        <div class="appbar__right">
          @!themeToggle()
          @if(auth.user)
            @link({ route: 'dashboard', class: 'btn btn--primary btn--sm' })
              Dashboard
            @end
          @else
            @link({ route: 'session.create', class: 'btn btn--ghost btn--sm' })
              Sign in
            @end
            @link({ route: 'new_account.create', class: 'btn btn--primary btn--sm' })
              Get started
            @end
          @end
        </div>
      </div>
    </header>
    {{{ await $slots.main() }}}
    @include('partials/flash_alerts')
  </body>
</html>
